root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript uses tabs, shown four columns wide (GitHub reads this too).
[*.gd]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{md,yml,cfg}]
indent_style = space

[Makefile]
indent_style = tab
